function Yes_Buy()
  no()

  local nItemIdx = GetTask(140)
  if (TBL_BuyItem[nItemIdx] == nil) then
    InfoBox("ThËt xin lçi, sai lo¹i h×nh vËt phÈm, h·y kiÓm tra l¹i cÊu h×nh!")
    return
  end

  local Cname, Cv, Cfs = GetCostCoinInfoByIdx(TBL_BuyItem[nItemIdx].costid)
  local nItemName = TBL_BuyItem[nItemIdx].name
  if (GetCoin() < Cv) then
    Talk(1, "no", "ThËt xin lçi, <c=y>" .. nItemName .. "<c> cÇn " .. Cfs .. " Th«ng B¶o, hiÖn Th«ng B¶o ch­a ®ñ, kh«ng thÓ mua.")
    return
  end

  if (IsHaveSpaceForTreasure(2) == 0) then
    Talk(1, "no", "Xin lçi, tói ®Çy, h·y s¾p xÕp l¹i. ")
