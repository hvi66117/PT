  end

  if (CostCoinByIdx(TBL_BuyItem[nItemIdx].costid) ~= 0) then
    SetTaskByte(TBL_BuyItem[nItemIdx].taskid[1], TBL_BuyItem[nItemIdx].taskid[2], g_BuyItemDay)
