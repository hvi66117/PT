function UsePointItem(nIndex)
  nIndex = 49 + nIndex
  if (tbl_PointItem[nIndex] == nil) then
    return 0
  end

  local tItemID = tbl_PointItem[nIndex].id
  if (#tItemID < 4 or HaveNormalItem(tItemID[1], tItemID[2], tItemID[3], tItemID[4]) <= 0) then
    return 0
  end

  local tItemList = tbl_PointItem[nIndex].item1
  if (tbl_PointItem[nIndex].isNewServer == 1 and GetGameServerName() == g_NewServerName) then
    tItemList = tbl_PointItem[nIndex].item2
  end

  if (IsHaveSpaceForTreasure(tItemList.bag + 1) == 0) then
    InfoBox("Tói kh«ng ®ñ « trèng " .. tItemList.bag .. " h·y s¾p xÕp l¹i tói.")
    return 0
  end

  if (tItemList.Select ~= nil) then
    local opra = {}
    for i = 1, #tItemList.Select do
      if (tItemList.Select[i] ~= nil and tItemList.Select[i] > 0 and tItemList.Select[i] < #tItemList) then
        local tSelectID = tItemList.Select[i]
        opra[#opra + 1] = tItemList[tSelectID].name .. "/SelectItem"
      end
    end

    SetTask(140, nIndex)
    Say("H·y chän phÇn th­ëng ngµi muèn nhËn.", #opra, opra)
    return 1
  end

  DelNormalItem(tItemID[1], tItemID[2], tItemID[3], tItemID[4])

  local nStr = "Ngµi më " .. tbl_PointItem[nIndex].name .. " nhËn ®­îc "
  local nTemp = {}
  for i = 1, #tItemList do
    if #tItemList[i].id == 7 then
      nTemp = tItemList[i].id
      for j = 1, tItemList[i].num do
        AddNormalItemBind(nTemp[1], nTemp[2], nTemp[3], nTemp[4], nTemp[5], nTemp[6], nTemp[7])
      end
      nStr = nStr .. tItemList[i].num .. " c¸i " .. tItemList[i].name .. ";"
    end
    if (#tItemList[i].id) == 2 then
      AddIBBuff(tItemList[i].id[1], tItemList[i].id[2])
      nStr = nStr .. tItemList[i].num .. " c¸i " .. tItemList[i].name .. ";"
    end
  end

  Msg2Player(nStr)
  WriteLog("[" .. tbl_PointItem[nIndex].name .. "]")
  return 1
end

function SelectItem(nIdx)
  CloseDialog()
  local nIndex = GetTask(140)
  if (tbl_PointItem[nIndex] == nil) then
    return 0
  end

  local tItemID = tbl_PointItem[nIndex].id
  if (#tItemID < 4 or HaveNormalItem(tItemID[1], tItemID[2], tItemID[3], tItemID[4]) <= 0) then
    return 0
  end

  local tItemList = tbl_PointItem[nIndex].item1
  if (tbl_PointItem[nIndex].isNewServer == 1 and GetGameServerName() == g_NewServerName) then
    tItemList = tbl_PointItem[nIndex].item2
  end

  DelNormalItem(tItemID[1], tItemID[2], tItemID[3], tItemID[4])

  local nStr = "Ngµi më " .. tbl_PointItem[nIndex].name .. " nhËn ®­îc "
  local nTemp = {}
  for i = 1, #tItemList do
    if (i == tItemList.Select[nIdx + 1]) or (tItemList.Select ~= nil and IsInSelectTable(i, tItemList.Select) == 0) then
      if #tItemList[i].id == 7 then
        nTemp = tItemList[i].id
        for j = 1, tItemList[i].num do
          AddNormalItemBind(nTemp[1], nTemp[2], nTemp[3], nTemp[4], nTemp[5], nTemp[6], nTemp[7])
        end
        nStr = nStr .. tItemList[i].num .. " " .. tItemList[i].name .. ";"
      end
      if #tItemList[i].id == 2 then
        AddIBBuff(tItemList[i].id[1], tItemList[i].id[2])
        nStr = nStr .. tItemList[i].num .. " " .. tItemList[i].name .. ";"
      end
    end
  end

  Msg2Player(nStr)
  WriteLog("[" .. tbl_PointItem[nIndex].name .. "]")
  return 1
end

function IsInSelectTable(nIdx, tTable)
  if (nIdx <= 0 or tTable == nil) then
    return 0
  end
  for i = 1, #tTable do
    if (nIdx == tTable[i]) then
      return 1
    end
  end
  return 0
end

function ChangeBindCoin()
  CloseDialog()
  if (GetTaskByte(Task_GetLuckyDoubleItem, 1) ~= g_InchargeTaskValue) then
    SetTaskByte(Task_GetLuckyDoubleItem, 1, g_InchargeTaskValue)
    SetTaskByte(Task_GetLuckyDoubleItem, 2, 0)
  end

  local nTaskTimes = GetTaskByte(Task_GetLuckyDoubleItem, 2)
  if (nTaskTimes >= 10) then
    InfoBox("ThËt xin lçi, ho¹t ®éng lÇn nµy ®· ®æi 10 lÇn Linh B¶o, kh«ng thÓ ®æi thªm, h·y chê ho¹t ®éng lÇn sau.")
    return
  end

  MsgBox("§iÓm tÝch lòy hiÖn t¹i lµ <c=yel>" .. (GetExtPoint(4) + GetTask(1893)) .. " ®iÓm <c>. HiÖn t¹i mçi <c=g>" .. g_BindCoinPoint .. " ®iÓm<c> tÝch lòy cã thÓ ®æi <c=yel>5 Linh B¶o<c>, mçi ng­êi tèi ®a ®æi 10 lÇn, ngµi muèn thö 1 lÇn sao?", "ChangeBindCoinSure", "no")
end

function ChangeBindCoinSure()
  CloseDialog()
  if (GetTaskByte(Task_GetLuckyDoubleItem, 1) ~= g_InchargeTaskValue) then
    SetTaskByte(Task_GetLuckyDoubleItem, 1, g_InchargeTaskValue)
    SetTaskByte(Task_GetLuckyDoubleItem, 2, 0)
  end

  local nTaskTimes = GetTaskByte(Task_GetLuckyDoubleItem, 2)
  if (nTaskTimes >= 10) then
    InfoBox("ThËt xin lçi, ho¹t ®éng lÇn nµy ®· ®æi 10 lÇn Linh B¶o, kh«ng thÓ ®æi thªm, h·y chê ho¹t ®éng lÇn sau.")
    return
  end

  local points = GetExtPoint(4) + GetTask(1893)
  if (points >= g_BindCoinPoint) then
    local nfuli = GetTask(1893)
    if (nfuli >= g_BindCoinPoint) then
      SetTask(1893, nfuli - g_BindCoinPoint)
    elseif (PayExtPoint(4, g_BindCoinPoint) <= 0) then
      InfoBox("Xin lçi, lÇn nµy trõ ®iÓm tÝch lòy thÊt b¹i, mêi thö l¹i!!")
      return 0
    end

    SetTaskByte(Task_GetLuckyDoubleItem, 2, nTaskTimes + 1)
    AddBindCoin(500)
    TopMessage("Ngµi nhËn ®­îc <c=yel>5 Linh B¶o<c>")
    WriteLog("[KhuyÕn m¹i n¹p thÎ][NhËn ®­îc][5 Linh B¶o]")
    MsgBox("Ngµi tiªu phÝ <c=g>" .. g_BindCoinPoint .. " ®iÓm tÝch lòy<c> ®æi lÊy <c=yel>5 Linh B¶o<c>. §iÓm tÝch lòy cßn l¹i lµ <c=yel>" .. (GetExtPoint(4) + GetTask(1893)) .. "<c> ®iÓm, cã muèn tiÕp tôc nhËn th­ëng?", "ChangeBindCoinSure", "no")
  else
    Talk(1, "no", "§iÓm tÝch lòy cßn l¹i kh«ng ®ñ, xin kiÓm tra l¹i.")
  end
end

function CheckNotOpenServer(id)
  if (id <= 0 or id > #TBL_PointLottery) then
    InfoBox("ThËt xin lçi, sai lo¹i h×nh rót th¨m.")
    return 0
  end

  local nServerName = GetGameServerName()
  local nFlag = 1
  for i = 1, #TBL_PointLottery[id].notOpenServer do
    if (nServerName == TBL_PointLottery[id].notOpenServer[i]) then
      nFlag = 0
    end
  end

  return nFlag
end

function IsNewServer()
  if (g_NewServerName ~= nil and g_NewServerName ~= "" and GetGameServerName() == g_NewServerName) then
    return 1
  end
  return 0
end

function IsNewServerNotCan(nItemIdx)
  if (IsNewServer() == 0) then
    return 0
  end

  local nItemName = GetLotteryItemName(nItemIdx)
  for i = 1, #tbl_NewServerNoItem do
    --if (nItemName == tbl_NewServerNoItem[i]) then
    if string.find(tbl_NewServerNoItem[i], nItemName) then
      return 1
    end
  end
  return 0
end

function CheckCanGetItem()
  local key = GetExtPoint(6)
  local points = GetExtPoint(4) + GetTask(1893)
  for i = 50, 55 do
    if (tbl_PointItem[i] == nil or IsNewServerNotCan(i) == 1) then
      break
    end
    local thisPoint, newPoint = GetLotteryItemPoint(i)
    if (IsNewServer() == 1) then
      thisPoint = newPoint
    end
    if (points >= thisPoint and GetBit(key, tbl_PointItem[i].extPoint) == 0) then
      return 1
    end
  end

  return 0
end

function PointLottery(id)
  id = id + 1

  if not (COMMON.IsInDateTimeRange(G_SaleActiveDay[1], G_SaleActiveDay[2])) then
    InfoBox("Ho¹t ®éng ­u ®·i n¹p thÎ hiÖn ch­a më, h·y ®îi thªm!")
    return 0
  end

  if (id <= 0 or id > #TBL_PointLottery) then
    InfoBox("ThËt xin lçi, sai lo¹i h×nh rót th¨m.")
    return 0
  end

  if (CheckCanGetItem() > 0) then
    InfoBox("§iÓm n¹p thÎ cña b¹n ®· ®¹t ®ñ ®iÒu kiÖn ®Ó nhËn quµ, b¹n nªn nhÊp vµo trang \"H¶o LÔ Trî ChiÕn\" ®Ó nhËn gãi quµ t­¬ng øng.")
    return 0
  end

  if (CheckNotOpenServer(id) == 0) then
    InfoBox("ThËt xin lçi, lo¹i h×nh rót th¨m nµy t¹m ch­a më t¹i m¸y chñ hiÖn t¹i, h·y ®îi thªm!")
    return 0
  end

  if (GetTaskByte(1975, 4) ~= g_InchargeTaskValue) then
    SetTask(1975, 0)
    SetTaskByte(1975, 4, g_InchargeTaskValue)
  end

  local nItemNum = GetTaskByte(TBL_PointLottery[id].itemNum[1], TBL_PointLottery[id].itemNum[2])
  if (TBL_PointLottery[id].itemMax > 0 and nItemNum >= TBL_PointLottery[id].itemMax) then
    InfoBox("LÇn ho¹t ®éng nµy ngµi ®· rót " .. nItemNum .. " lÇn " .. TBL_PointLottery[id].name .. ", lÇn sau h·y quay l¹i.")
    return 0
  end

  if (IsHaveSpaceForTreasure(2) == 0) then
    InfoBox("Hµnh trang kh«ng cã ®ñ 1 « trèng, xin h·y s¾p xÕp l¹i.")
    return
  end

  local nPayPoint = TBL_PointLottery[id].point
  if (TBL_PointLottery[id].firstPoint > 0 and nItemNum == 0) then
    nPayPoint = TBL_PointLottery[id].firstPoint
  end

  local nLotteryNum = GetTask(TBL_PointLottery[id].numTask) + 1
  local nfuli = GetTask(1893)
  local points = GetExtPoint(4) + nfuli
  if (points >= nPayPoint) then
    if (nfuli >= nPayPoint) then
      SetTask(1893, nfuli - nPayPoint)
    elseif (PayExtPoint(4, nPayPoint) <= 0) then
      InfoBox("Xin lçi, lÇn nµy trõ ®iÓm tÝch lòy thÊt b¹i, mêi thö l¹i!!")
      return 0
    end

    for i = 1, nPayPoint do
      NewServerEx.Pet_GetPilesTask(9)
    end

    local nRand = math.random(1, 100000)
    SetTask(TBL_PointLottery[id].numTask, nLotteryNum)

    local data = TBL_PointLottery[id].data
    local lucky = 0
    for i = 1, #data do
      if (nLotteryNum <= data[i][1]) then
        lucky = data[i][3] + math.floor((nLotteryNum - data[i - 1][1]) / data[i][2]) * data[i][4]
        break
      end
    end

    if nLotteryNum >= data[#data][1] then
      lucky = 100000
    end

    if (nRand <= lucky) then
      return issel(id)
    else
      return remain(id)
    end
  else
    Talk(1, "no", "Xin lçi, ®iÓm tÝch lòy cña ngµi kh«ng ®ñ <c=r>" .. nPayPoint .. " ®iÓm<c>, ®iÓm tÝch lòy cßn l¹i lµ <c=yel>" .. points .. " ®iÓm<c>.")
  end
end

function issel(id)
  if id <= 0 or id > #TBL_PointLottery then
    InfoBox("ThËt xin lçi, sai lo¹i h×nh rót th¨m.")
    return 0
  end

  local playerTy = GetPlayerType() + 1
  local itemList = TBL_PointLottery[id].item
  local nItemNum = 0

  if (TBL_PointLottery[id].itemNum[1] ~= -1) then
    nItemNum = GetTaskByte(TBL_PointLottery[id].itemNum[1], TBL_PointLottery[id].itemNum[2]) + 1
    SetTaskByte(TBL_PointLottery[id].itemNum[1], TBL_PointLottery[id].itemNum[2], nItemNum)
  end

  WriteLog("[KhuyÕn m¹i n¹p thÎ][NhËn ®­îc][" .. itemList.name .. "] sè lÇn nhÊn " .. GetTask(TBL_PointLottery[id].numTask))
  SetTask(TBL_PointLottery[id].numTask, 0)
  if (nItemNum == 1) then
    AddNormalItemBind(itemList.id[1], itemList.id[2], itemList.id[3], itemList.id[4], itemList.id[5], itemList.id[6], 1)
  else
    AddNormalItemBind(itemList.id[1], itemList.id[2], itemList.id[3], itemList.id[4], itemList.id[5], itemList.id[6], itemList.id[7])
  end

  Talk(1, "no", "B¹n nhËn ®­îc <c=yel>" .. itemList.name .. "<c>")
  TopMessage("B¹n nhËn ®­îc <c=yel>" .. itemList.name .. "<c>")
  Msg2Player("B¹n nhËn ®­îc " .. itemList.name)
  AddGlobalCountNews("<c=g><RoleName=\"" .. GetName() .. "\"><c> tham gia rót th¨m may m¾n nhËn ®­îc <c=r>" .. itemList.name .. "<c>, chóc mõng!", 3)

  SetLotteryItemEffect(itemList.idx, -1)
end

function remain(key)
  if (TBL_PointLottery[key] == nil or TBL_PointLottery[key].otheritem == nil) then
    InfoBox("ThËt xin lçi, sai lo¹i h×nh rót th¨m.")
    return 0
  end
  local other_data = TBL_PointLottery[key].otheritem

  local str = ""
  local luckshow = { [1] = { 2500, 1 }, [2] = { 9500, 3 }, [3] = { 10000, 2 } }
  local nFlag = 0
  local str1 = ""
  local rand = 0
  local logstr = "[KhuyÕn m¹i n¹p thÎ][BÊm][" .. TBL_PointLottery[key].name .. "]" .. GetTask(TBL_PointLottery[key].numTask) .. "´Î: "
  local r_other = math.random(1, 10000)
  for j = 1, 3 do
    if (r_other <= luckshow[j][1]) then
      str = " §iÓm may m¾n t¨ng thªm <c=g>" .. luckshow[j][2] .. " ®iÓm<c>."
      break
    end
  end

  if (IsNewServer() == 1) then
    for i = 1, #TBL_PointLottery[key].otheritem do
      rand = rand + TBL_PointLottery[key].otheritem[i].newrate
      if (r_other <= rand) then
        nFlag = i
        break
      end
    end
  else
    for i = 1, #TBL_PointLottery[key].otheritem do
      rand = rand + TBL_PointLottery[key].otheritem[i].rate
      if (r_other <= rand) then
        nFlag = i
        break
      end
    end
  end

  if (nFlag >= 1 and nFlag <= #TBL_PointLottery[key].otheritem and TBL_PointLottery[key].otheritem[nFlag].idx >= 0) then
    AddLotteryItemByIdx(TBL_PointLottery[key].otheritem[nFlag].idx, 0)
    if (TBL_PointLottery[key].otheritem[nFlag].isAnnounce == 1) then
      AddGlobalCountNews("<c=g><RoleName=\"" .. GetName() .. "\"><c> trong ho¹t ®éng tÝch ®iÓm nhËn quµ, nhËn ®­îc <c=g>" .. TBL_PointLottery[key].otheritem[nFlag].name .. "<c>, chóc mõng!", 1)
      Msg2CurMapAnnounce("<c=g><RoleName=\"" .. GetName() .. "\"><c> trong ho¹t ®éng tÝch ®iÓm nhËn quµ, nhËn ®­îc <c=g>" .. TBL_PointLottery[key].otheritem[nFlag].name .. "<c>, chóc mõng!")
      logstr = logstr .. TBL_PointLottery[key].otheritem[nFlag].name
    end
    str1 = "B¹n nh©n ®­îc " .. TBL_PointLottery[key].otheritem[nFlag].name .. ","
  else
    str1 = "B¹n kh«ng nhËn ®­îc g×, "
  end
  str1 = str1 .. "H·y tiÕp tôc rÌn luyÖn!"
  Msg2Player(str1)
  TopMessage(str1)
  WriteLog(logstr)

  SetLotteryItemEffect(TBL_PointLottery[key].otheritem[nFlag].idx, nFlag - 1)
end

function LotteryGift(nType, nItemIdx)
  CloseDialog()
  if (nType == 1) then

    if (nItemIdx == 59 or nItemIdx == 58) then
      RuYi(nItemIdx)
      return
    elseif (nItemIdx >= 63 and nItemIdx <= 65) then
      HaoLiNew(nItemIdx)
      return
    else
      HaoLi(nItemIdx)
    end
  elseif (nType == 2) then
    FuShi(nItemIdx)
  elseif (nType == 3) then
    XianLiang(nItemIdx)
  elseif (nType == 4) then
    FuHao(nItemIdx)
  end
end

function HaoLi(nItemIdx)
  CloseDialog()

  if not (COMMON.IsInDateTimeRange(G_SaleActiveDay[1], G_SaleActiveDay[2])) then
    InfoBox("Ho¹t ®éng H¶o LÔ Trî ChiÕn ch­a më, h·y quay l¹i sau!")
    return
  end

  if (IsNewServerNotCan(nItemIdx) == 1) then
    InfoBox("ThËt xin lçi, m¸y chñ hiÖn t¹i kh«ng më phÇn quµ nµy.")
    return
  end

  if (tbl_PointItem[nItemIdx] == nil) then
    InfoBox("ThËt xin lçi, sai lo¹i h×nh rót sè!")
    return
  end

  local key = GetExtPoint(6)
  local nItemNum = 0
  local nIndex = nItemIdx
  if (GetBit(key, tbl_PointItem[nIndex].extPoint) == 1) then
    Talk(1, "no", "ThËt xin lçi, ngµi ®· nhËn lÔ bao nµy råi.")
    return
  end

  local points = GetExtPoint(4) + GetTask(1893)
  local thisPoint, newPoint = GetLotteryItemPoint(nIndex)
  if (IsNewServer() == 1) then
    thisPoint = newPoint
  end
  if (points < thisPoint) then
    Talk(1, "no", "ThËt xin lçi, ®iÓm tÝch lòy kh«ng ®ñ <c=g>" .. thisPoint .. "<c>, h·y kiÓm tra l¹i ®iÓm tÝch lòy cßn l¹i.")
    return
  end

  if (IsHaveSpaceForTreasure(2) == 0) then
    Talk(1, "no", "Hµnh trang ®· ®Çy, xin h·y s¾p xÕp l¹i.")
    return
  end

  AddExtPoint(6, 2 ^ (tbl_PointItem[nIndex].extPoint - 1))
  local nItem = tbl_PointItem[nIndex].id
  local str = tbl_PointItem[nIndex].name

  AddNormalItemBind(nItem[1], nItem[2], nItem[3], nItem[4], nItem[5], nItem[6], 1)
  if (str == "Tói quµ danh väng") then
    SetTask(1868, 0)
  end
  WriteLog("[KhuyÕn m¹i n¹p thÎ][NhËn ®­îc][" .. str .. "]")
  TopMessage("B¹n nhËn ®­îc <c=yel>" .. str .. "<c>")
  InfoBox("B¹n nhËn ®­îc <c=yel>" .. str .. "<c>")
end

function RuYi(nItemIdx)
  if (nItemIdx < 58 and nItemIdx > 59) then
    InfoBox("ThËt xin lçi, sai lo¹i h×nh rót sè.")
    return
  end

  if not (COMMON.IsInDateTimeRange(G_SaleActiveDay[1], G_SaleActiveDay[2])) then
    InfoBox("Ho¹t ®éng H¶o LÔ Trî ChiÕn ch­a më, h·y quay l¹i sau!")
    return
  end

  local RuyiPoint = GetLotteryItemPoint(nItemIdx)
  local points = GetExtPoint(4) + GetTask(1893)
  if (points >= RuyiPoint) then
    local nfuli = GetTask(1893)
    if (nfuli >= RuyiPoint) then
      SetTask(1893, nfuli - RuyiPoint)
    elseif (PayExtPoint(4, RuyiPoint) <= 0) then
      InfoBox("Xin lçi, lÇn nµy trõ ®iÓm tÝch lòy thÊt b¹i, mêi thö l¹i!!")
      return 0
    end

    local nNum = 2
    if (nItemIdx == 59) then
      nNum = 20
    end

    for i = 1, nNum do
      AddNormalItemPile(3, 138, 0, 0, 0, 1)
    end
    TopMessage("B¹n nhËn ®­îc <c=yel>" .. nNum .. " tÊm ThiÖp Nh­ ý<c>")
    Msg2Player("B¹n nhËn ®­îc <c=yel>" .. nNum .. " tÊm ThiÖp Nh­ ý<c>")
    WriteLog("[KhuyÕn m¹i n¹p thÎ][NhËn ®­îc][ThiÖp Nh­ ý" .. nNum .. "]")
    SayTask("Ngµi tiªu phÝ <c=g>" .. RuyiPoint .. " ®iÓm tÝch lòy<c> ®æi lÊy <c=yel>" .. nNum .. " tÊm ThiÖp Nh­ ý<c>. §iÓm tÝch lòy cßn l¹i lµ <c=yel>" .. (GetExtPoint(4) + GetTask(1893)) .. "<c> ®iÓm, cã muèn tiÕp tôc nhËn th­ëng?", tasks)
  else
    Talk(1, "no", "§iÓm tÝch lòy cßn l¹i kh«ng ®ñ, xin kiÓm tra l¹i.")
  end
end

function HaoLiNew(nItemIdx)
  if (nItemIdx < 63 or nItemIdx > 65) then
    InfoBox("ThËt xin lçi, sai lo¹i h×nh rót sè.")
