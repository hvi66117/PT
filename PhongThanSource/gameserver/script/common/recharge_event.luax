function GiveItem(nIndex)
  no()
  local nType = GetPlayerType()
  if (nIndex <= 0 or nIndex > #ItemList[nType + 1]) then
    InfoBox("Kh«ng cã vËt phÈm nµy hoÆc vËt phÈm ®· hÕt h¹n!")
    return
  end

  if (IsHaveSpaceForTreasure(2) == 0) then
    Talk(1, "no", "ThËt xin lçi, hµnh trang cña ngµi kh«ng cã ®ñ 1 « trèng.")
    return
  end

  local nRand = math.random(1, 1000)
  local tblItem = ItemList[nType + 1][nIndex]
  local nTempRand = 0
  local nStr = ""
  local itemNum = GetTaskByte(Task_Skill_Item, 2) + 1
  SetTaskByte(Task_Skill_Item, 2, itemNum)

  if (nIndex == 4 and GetTaskByte(Task_Skill_Item, 3) == 0) then
    tblItem = ItemList[nType + 1][5]
    SetTaskByte(Task_Skill_Item, 3, 1)
  end

  for i = 1, #tblItem do
    nTempRand = tblItem[i].Rate + nTempRand
    if (nRand <= nTempRand) then
      AddNormalItemBind(tblItem[i].id[1], tblItem[i].id[2], tblItem[i].id[3], 0, 0, 0, 1)
      Msg2Player("B¹n nhËn ®­îc 1 " .. tblItem[i].Name)
      WriteLog("[Mua Phï Th¹ch][NhËn ®­îc]" .. tblItem[i].Name)

      if (nIndex == 4 and (i <= #tblItem - #ItemList[nType + 1][5])) then
        SetTaskByte(Task_Skill_Item, 3, 0)
      end
      break
    end
  end
end

