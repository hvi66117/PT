    Talk(1, "no", "Chóc mõng ngµi nhËn ®­îc " .. nItemName .. ".")
    Msg2CurMapAnnounce("<c=g><RoleName=\"" .. GetName() .. "\"><c> vui t­¬i hín hë mua " .. nItemName .. "! NhËn ®­îc rÊt nhiÒu phÇn th­ëng!")
    WriteLog("[KhuyÕn m¹i n¹p thÎ][Mua]:" .. nItemName)
  else
    Talk(1, "no", "ThËt xin lçi, khÊu trõ Th«ng B¶o thÊt b¹i.")
  end
end

function FuHao(nItemIdx)

  if not (COMMON.IsInDateTimeRange(G_PointActiveDay[1], G_PointActiveDay[2])) then
    InfoBox("Ho¹t ®éng Phó Hµo Tèng LÔ t¹m ch­a më, h·y trë l¹i sau!")
    return
  end

  if (IsNewServerNotCan(nItemIdx) == 1) then
    InfoBox("ThËt xin lçi, m¸y chñ hiÖn t¹i kh«ng më phÇn quµ nµy.")
    return
  end

  if (TBL_FuHaoList[nItemIdx] == nil) then
    InfoBox("ThËt xin lçi, sai lo¹i h×nh vËt phÈm, h·y kiÓm tra l¹i cÊu h×nh!")
    return
  end

  if (GetTask(1874) ~= g_DateFlag) then
    SetTask(1874, g_DateFlag)
    SetTask(1801, 0)
  end

  if (GetTaskByte(1925, 4) ~= g_DateFlag) then
    SetTask(1925, 0)
    SetTask(1982, 0)
    SetTaskByte(1925, 4, g_DateFlag)
  end

  local gifttimes = GetTaskByte(TBL_FuHaoList[nItemIdx].task[1], TBL_FuHaoList[nItemIdx].task[2])
  local strName = TBL_FuHaoList[nItemIdx].name
  if (gifttimes >= TBL_FuHaoList[nItemIdx].count) then
    Talk(1, "no", "Ngµi ®· nhËn " .. strName .. ", kh«ng thÓ nhËn l¹i!")
    return
  end

  local thisPoint, newPoint = GetLotteryItemPoint(nItemIdx)
  if (IsNewServer() == 1) then
    thisPoint = newPoint
  end

  local value = GetTask(Task_CoinToBindcoin)
  local disCostCoin = value - gifttimes * thisPoint * 100
  local temp = math.mod(value, 100)
  local cfs = math.floor(value / 100)
  if (temp >= 10) then
    cfs = cfs .. "." .. temp
  else
    cfs = cfs .. ".0" .. temp
  end

  local nPoint = thisPoint * 100
  if (disCostCoin >= nPoint) then
    if (GetTaskByte(TBL_FuHaoList[nItemIdx].task[1], TBL_FuHaoList[nItemIdx].task[2]) < TBL_FuHaoList[nItemIdx].count) then
      SetTask(140, nItemIdx)
      MsgBox("Chóc mõng ngµi phï hîp " .. strName .. " ®iÒu kiÖn nhËn, cã muèn nhËn ngµy kh«ng?", "Yes_FuHao", "no")
    else
      Talk(1, "no", "Ngµi ®· nhËn " .. strName .. " th­ëng råi, kh«ng thÓ nhËn l¹i!")
      return
    end
  else
    Talk(1, "no", "ThËt xin lçi, ngµi ch­a ®ñ ®iÒu kiÖn nhËn th­ëng, tiªu phÝ hiÖn t¹i lµ:<c=g>" .. cfs .. "<c> Th«ng B¶o")
    return
  end
end

function Yes_FuHao()

  local nItemIdx = GetTask(140)
  if (TBL_FuHaoList[nItemIdx] == nil) then
    InfoBox("ThËt xin lçi, sai lo¹i h×nh vËt phÈm, h·y kiÓm tra l¹i cÊu h×nh!")
    return
  end

  if (IsHaveSpaceForTreasure(2) <= 0) then
    Talk(1, "no", "Xin lçi, tói kh«ng ®ñ 1 « trèng, h·y s¾p xÕp l¹i råi ®Õn ®©y")
    return
  end

  local thisPoint, newPoint = GetLotteryItemPoint(nItemIdx)
  if (IsNewServer() == 1) then
    thisPoint = newPoint
  end
  local value = GetTask(Task_CoinToBindcoin)
  local gifttimes = GetTaskByte(TBL_FuHaoList[nItemIdx].task[1], TBL_FuHaoList[nItemIdx].task[2])
  local disCostCoin = value - gifttimes * thisPoint * 100
  local temp = math.mod(value, 100)
  local cfs = math.floor(value / 100)
  if (temp >= 10) then
    cfs = cfs .. "." .. temp
  else
    cfs = cfs .. ".0" .. temp
  end

  local strName = TBL_FuHaoList[nItemIdx].name
  local nPoint = thisPoint * 100
  if (disCostCoin >= nPoint) then
    local nCount = GetTaskByte(TBL_FuHaoList[nItemIdx].task[1], TBL_FuHaoList[nItemIdx].task[2])
    if (nCount < TBL_FuHaoList[nItemIdx].count) then
      SetTaskByte(TBL_FuHaoList[nItemIdx].task[1], TBL_FuHaoList[nItemIdx].task[2], nCount + 1)
      AddLotteryItemByIdx(nItemIdx, TBL_FuHaoList[nItemIdx].bind)
      Talk(1, "no", "Chóc mõng ngµi, t¹i ho¹t ®éng tiªu phÝ nhËn ®­îc 1 " .. strName .. ".")
      local str = "<bc=r><RoleName=\"" .. GetName() .. "\"> nhËn ®­îc 1 " .. strName .. "!"
      Msg2CurMapAnnounce(str)
      if (IsTongMember() > 0) then
        Msg2TongMember(str)
      end
      WriteLog("[Tiªu phÝ " .. thisPoint .. " K][" .. strName .. "]")
    else
      Talk(1, "no", "Kh«ng thÓ nhËn l¹i phÇn th­ëng nµy!")
      return
    end
  else
    Talk(1, "no", "ThËt xin lçi, ngµi ch­a ®ñ ®iÒu kiÖn nhËn th­ëng, tiªu phÝ hiÖn t¹i lµ:<c=g>" .. cfs .. "<c> Th«ng B¶o")
    return
  end
end
