module("TENYEAR", package.seeall)

TENYEARGIFT = {
    [1] = { { 2017, 7, 18 }, { 2017, 7, 31 }, 45 },
    [2] = { { 2017, 6, 6 }, { 2017, 6, 13 }, 60 },
    [3] = { { 2017, 5, 31 }, { 2017, 6, 22 }, 120 },
    [4] = { { 2017, 6, 13 }, { 2017, 6, 22 }, 90 },
    [5] = { { 2017, 6, 1 }, { 2017, 6, 22 }, 0 },
}

function Pub_IsGratitudeBox()
    if (Pub_IsTENYEAR(1) == 1) then
        local y, m, d = GetYMD()
        if (d == TENYEARGIFT[1][1][3]) then
            local HH, MM, SS = GetHMS()
            if (HH <= 9) then
                return 0
            end
        end
        return 1
    else
        return 0
    end
end

function Pub_IsBachelorBox()
    local HH, MM, SS = GetHMS()

    if (HH == 20 and MM <= 5) and (Pub_IsTENYEAR(2) == 1) then
        return 1
    else
        return 0
    end
end

