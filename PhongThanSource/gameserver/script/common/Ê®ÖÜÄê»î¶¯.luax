function Pub_IsTENYEAR(key)
    if (key < 1) or (key > #TENYEARGIFT) then
        return 0
    end

    if (GetLevel() < TENYEARGIFT[key][3]) then
        return 0
    end

    local time1 = LocalYMD2Time(TENYEARGIFT[key][1][1], TENYEARGIFT[key][1][2], TENYEARGIFT[key][1][3]) - SystemTime()
    local time2 = LocalYMD2Time(TENYEARGIFT[key][2][1], TENYEARGIFT[key][2][2], TENYEARGIFT[key][2][3] + 1) - SystemTime()
    if (time1 <= 0 and time2 > 0) then
        return 1
    end
    return 0
end
