    local msgstr = "ĞÂ´ºµ½," .. GetName() .. "ÔÚ´Ë×£´ó¼Ò: " .. HaoYunHongBao_Say[nIdx]
    if (IsTongMember() == 1) then
        if (DelNormalItem(HaoYunHongBaoId[1], HaoYunHongBaoId[2], HaoYunHongBaoId[3], HaoYunHongBaoId[4]) > 0) then
            Msg2TongMember(msgstr)
            GiveItem()
            WriteLog("[ĞÂ´º¼ªÏéÀñ°ü][ÓĞ¹ú¼Ò][" .. msgstr .. "]")
        else
            WriteLog("[´ò¿ªĞÂ´º¼ªÏéÀñ°üÊ§°Ü][ÓĞ¹ú¼Ò][Î´»ñµÃ½±Àø]")
