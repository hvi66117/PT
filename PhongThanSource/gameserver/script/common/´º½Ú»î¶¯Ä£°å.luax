function GetXinChunLiHua()
    if (GetLevel() < 60 and GetNewBirthTimes() < 1) then
        return
    end
    if (COMMON.IsInDateTimeRange(XinChunLiHua_Date[1], XinChunLiHua_Date[2])) then
        local Y, M, D = GetYMD()
        local lastday = GetTaskByte(XinChunLiHua, 2)
        if (lastday ~= D) then
            SetTaskByte(XinChunLiHua, 1, 0)
            SetTaskByte(XinChunLiHua, 2, D)
            SetTaskByte(XinChunLiHua, 3, 0)
        end
        if (GetTaskByte(XinChunLiHua, 1) == 0) then
            local killnum = GetTaskByte(XinChunLiHua, 3)
            if (killnum < 200) then
                killnum = killnum + 1
                SetTaskByte(XinChunLiHua, 3, killnum)
            end

            local rannum = math.random(1000)
            if (rannum <= 5 or killnum >= 50) then
                SetTaskByte(XinChunLiHua, 1, 1)
                AddNormalItemBind(LiHuaId[1], LiHuaId[2], LiHuaId[3], LiHuaId[4], 0, 0, 1)
                Msg2Player("Ngµi nhËn ®­îc 1 ĞÂ´ºÀñ»¨.")
                WriteLog("[Àñ»¨ÉùÉùÓ­ĞÂÄê][NhËn ®­îcĞÂ´ºÀñ»¨]")
            end
        end
    end
end
