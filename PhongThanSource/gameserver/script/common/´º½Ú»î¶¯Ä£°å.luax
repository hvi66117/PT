function GiveItem()
    local tItemlist = {
        [1] = { itemname = "Thanh Lé (tiÓu)", itemid = { 8, 28, 3, 0 }, count = 1, pro = 25, itemtype = "item", annouce = 0 },
        [2] = { itemname = "Ch©n Khİ (tiÓu)", itemid = { 8, 29, 4, 0 }, count = 1, pro = 25, itemtype = "item", annouce = 0 },
        [3] = { itemname = "M¶nh Hång thñy tinh", itemid = { 3, 77, 0, 0 }, count = 1, pro = 10, itemtype = "item", annouce = 0 },
        [4] = { itemname = "M¶nh Lôc Thñy tinh", itemid = { 3, 248, 0, 0 }, count = 1, pro = 10, itemtype = "item", annouce = 0 },
        [5] = { itemname = "T­íng Qu©n LÖnh", itemid = { 3, 100, 0, 0 }, count = 1, pro = 1, itemtype = "item", annouce = 1 },
        [6] = { itemname = "B¹c khãa", itemid = { 1000000 }, count = 1, pro = 29, itemtype = "yinyuan", annouce = 0 },
    }

    local YY, MM, DD = GetYMD()
    YY = YY - 2000
    if (GetGlobalStoreValueByte(HYHB_Global, 3) ~= YY) then
        SetGlobalStoreValueWord(HYHB_Global, 1, 0, 1)
        SetGlobalStoreValueByte(HYHB_Global, 3, YY, 1)
        SetGlobalStoreValueByte(HYHB_Global, 4, DD, 1)
    elseif (GetGlobalStoreValueByte(HYHB_Global, 4) ~= DD) then
        SetGlobalStoreValueWord(HYHB_Global, 1, 0, 1)
        SetGlobalStoreValueByte(HYHB_Global, 4, DD, 1)
    end

    if (GetTaskByte(HaoYunHongBao_Times, 4) == DD) then
        Talk(1, "no", "Äú½ñÌìÒÑ¾­¿ª¹ıĞÂ´º¼ªÏéºì°üÁË!")
        return
    else
        SetTaskByte(HaoYunHongBao_Times, 4, DD)
    end

    local times = GetGlobalStoreValueWord(HYHB_Global, 1)
    times = times + 1
    if (times == 100) then
        SetGlobalStoreValueWord(HYHB_Global, 1, times, 1)
        AddNormalItemBind(8, 1670, 2, 1, 0, 0, 1)
        Msg2Player("ĞÂÄêĞĞ´óÔË!Äú´ò¿ªĞÂ´ººì°ü nhËn ®­îc 1 Tói Ngäc Tinh!")
        Msg2TongMember("Anh hïng " .. GetName() .. "ºÃÔËµ±Í·,´ò¿ªĞÂ´ººì°ü nhËn ®­îc 1 Tói Ngäc Tinh!")
        AddGlobalNews("Anh hïng " .. GetName() .. "ºÃÔËµ±Í·,´ò¿ªĞÂ´ººì°ü nhËn ®­îc 1 Tói Ngäc Tinh!")
        WriteLog("[´ò¿ªĞÂ´º¼ªÏéÀñ°ü][NhËn ®­îc Tói Ngäc Tinh]")
        return
    elseif (times == 299) then
        SetGlobalStoreValueWord(HYHB_Global, 1, times, 1)
        AddNormalItemBind(3, 374, 0, 0, 0, 0, 1)
        Msg2Player("ĞÂÄêĞĞ´óÔË!Äú´ò¿ªĞÂ´ººì°ü nhËn ®­îc 1 Vi Quang Qu¸i Phï (ch­a khai quang)!")
        Msg2TongMember("Anh hïng " .. GetName() .. "ºÃÔËµ±Í·,´ò¿ªĞÂ´ººì°ü nhËn ®­îc 1 Vi Quang Qu¸i Phï (ch­a khai quang)!")
        AddGlobalNews("Anh hïng " .. GetName() .. "ºÃÔËµ±Í·,´ò¿ªĞÂ´ººì°ü nhËn ®­îc 1 Vi Quang Qu¸i Phï (ch­a khai quang)!")
        WriteLog("[´ò¿ªĞÂ´º¼ªÏéÀñ°ü][NhËn ®­îc Vi Quang Qu¸i Phï]")
        return
    end

    SetGlobalStoreValueWord(HYHB_Global, 1, times, 1)
    local rannum = math.random(100)
    local prob = 0
    for i = 1, table.getn(tItemlist) do
        prob = prob + tItemlist[i].pro
        if (rannum <= prob) then
            if (tItemlist[i].itemtype == "item") then
                for j = 1, tItemlist[i].count do
                    AddNormalItemBind(tItemlist[i].itemid[1], tItemlist[i].itemid[2], tItemlist[i].itemid[3], tItemlist[i].itemid[4], 0, 0, 1)
                end
                Msg2Player("Chóc mõng ngµi më ºì°ü nhËn ®­îc " .. tItemlist[i].itemname .. "*" .. tItemlist[i].count .. ".")
                WriteLog("[´ò¿ªĞÂ´º¼ªÏéÀñ°ü][NhËn ®­îc " .. tItemlist[i].itemname .. "]")
                if (tItemlist[i].annouce == 1) then
                    Msg2TongMember("ĞÂÄêĞĞ´óÔË!Äú´ò¿ªĞÂ´ººì°ü nhËn ®­îc " .. tItemlist[i].itemname .. "!")
                    AddGlobalNews("Anh hïng " .. GetName() .. "ºÃÔËµ±Í·, ´ò¿ªĞÂ´ººì°ü nhËn ®­îc " .. tItemlist[i].itemname .. "!")
                end
            elseif (tItemlist[i].itemtype == "yinyuan") then
                EarnBind(tItemlist[i].itemid[1])
                Msg2Player("Chóc mõng b¹n nhËn ®­îc " .. tItemlist[i].itemname .. tItemlist[i].itemid[1] .. ".")
                WriteLog("[´ò¿ªĞÂ´º¼ªÏéÀñ°ü][NhËn ®­îc 1000000 b¹c kho¸ .]")
            end
            break
        end
    end
end

function LoadMonkey()
    if not (COMMON.IsInDateTimeRange(FindMonkey_Date[1], FindMonkey_Date[2])) then
        return
    end
    local ranmap = math.random(6)
    local ranlocation = math.random(4)
    local map = SubWorldID2Idx(MonKeyMap[ranmap].mapid)
    local npcIndex = AddNpc(2304, 100, map, MonKeyMap[ranmap][ranlocation][1] * 32, MonKeyMap[ranmap][ranlocation][2] * 32)
    if (npcIndex > 0) then
        local OldPlayer = PlayerIndex
        PlayerIndex = GetFirstPlayerInAll()
        WriteLog("Ğ¡ºï×Ó: ÎÒÔÚ" .. MonKeyMap[ranmap].mapid .. "µÄx:" .. MonKeyMap[ranmap][ranlocation][1] .. "y:" .. MonKeyMap[ranmap][ranlocation][2])
        SetNpcScript(npcIndex, "\\script\\»î¶¯½Å±¾\\Çó°®µÄĞ¡ºï×Ó.lua")
        SetNpcName(npcIndex, "<c=r>TuÇn S¬n TiÓu HÇu")
        SetNpcTimer(npcIndex, "\\script\\ontimer\\Çó°®µÄĞ¡ºï×ÓÉ¾µô×Ô¼º.lua", 1750)
        PlayerIndex = OldPlayer
    else
        local OldPlayer = PlayerIndex
        PlayerIndex = GetFirstPlayerInAll()
        WriteLog("[Ğ¡ºï×ÓÍ¶·ÅÊ§°Ü]")
        PlayerIndex = OldPlayer
    end
end

function no()
    CloseDialog()
end
