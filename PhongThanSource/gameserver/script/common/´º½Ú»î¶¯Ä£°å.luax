function IsHaoYunHongBaoActive()
    if (COMMON.IsInDateTimeRange(HaoYunHongBao_Date[1], HaoYunHongBao_Date[2])) then
        return 1
    end
    return 0
end
function GetHaoYunHongBao()
    if (GetGameServerName() == NewServerEx.g_ServerName) then
        if (GetLevel() < 60 and GetNewBirthTimes() < 1) then
            Talk(1, "no", "60¼¶¼°ÒÔÉÏÍæ¼Ò²Å¿ÉÒÔNhËn lÔ bao.")
            return
        end
    else
        if (GetLevel() < 90 and GetNewBirthTimes() < 1) then
            Talk(1, "no", "90¼¶¼°ÒÔÉÏÍæ¼Ò²Å¿ÉÒÔNhËn lÔ bao.")
            return
        end
    end
    local Y, M, D = GetYMD()

    if (GetTaskWord(HaoYunHongBao_Times, 1) ~= Y) then
        SetTaskWord(HaoYunHongBao_Times, 1, Y)
        SetTaskByte(HaoYunHongBao_Times, 3, 0)
        SetTaskByte(HaoYunHongBao_Times, 4, 0)
        SetTaskByte(Monkey_and_Money, 4, 0)
        SetTaskByte(Monkey_and_Money, 3, 0)
    end

    if (GetTaskByte(Monkey_and_Money, 4) ~= D) then
        SetTaskByte(Monkey_and_Money, 4, D)
        SetTaskByte(Monkey_and_Money, 3, 0)
    end

    local ntotal = GetTaskByte(HaoYunHongBao_Times, 3) + 1
    if (ntotal > 5) then
        Talk(1, "no", "Xin lçi, Õû¸ö»î¶¯ÖÜÆÚÄÚ, ×î¶àÖ»ÄÜÁìÈ¡<c=r> 5 c¸i <c>ĞÂ´º¼ªÏéºì°üÁË!")
        return
    end

    if (GetTaskByte(Monkey_and_Money, 3) == 1) then
        Talk(1, "no", "Äú½ñÌìÒÑ¾­ÁìÈ¡¹ıĞÂ´º¼ªÏéºì°üÁË!")
        return
    end

    AddNormalItemBind(HaoYunHongBaoId[1], HaoYunHongBaoId[2], HaoYunHongBaoId[3], HaoYunHongBaoId[4], 0, 0, 1)
    SetTaskByte(Monkey_and_Money, 3, 1)
    SetTaskByte(HaoYunHongBao_Times, 3, ntotal)

    Talk(1, "no", "ĞÂ´º·¢ºì°ü,¼ªÏéºÃÔËÀ´!¿ì¸øÉí±ßµÄÅóÓÑËÍÉÏ×£¸£,´ò¿ªºì°ü³éÈ¡½±Àø°É!")
    Msg2Player("NhËn ®­îc ºÃÔËºì°ü.")
    WriteLog("[NhËn ®­îcĞÂ´º¼ªÏéºì°ü]ÀÛ¼Æ: " .. ntotal)

end
