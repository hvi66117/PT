function GetIllagelInfo(area, account_name)
    local flag = 0
    local number = 0

    for key, value in ipairs(illegalGainBookList) do
        if (value[1] == area and value[2] == account_name) then
            flag = 1
            number = value[3]
            break
        end
    end

    return flag, number
end

function beast(npcindex, mapid, px, py, select_index)

    local select_starttime = GetTask(task_starttime)

    local target_npcidx = TaskList[select_index].id
    local target_time = SystemTime()
    local target_item = TaskList[select_index].throwitem

    if (HaveIBBuff(TaskList[select_index].flagbuff) == 0) then
        return
    end

    if (target_time - select_starttime > 3 * 60) then
        return
    end

    BeastThrowItem(npcindex, px, py, select_index)

end

function pos_ok(px, py, distance)

    local flag_posX = GetTaskWord(task_pos, 1)
    local flag_posY = GetTaskWord(task_pos, 2)

    local tmpDistance = (px / 8 - flag_posX) ^ 2 * 32 + (py / 8 / 2 - flag_posY) ^ 2 * 32
    if (tmpDistance > distance) then
        return -1
    end

    return tmpDistance
end

function BeastThrowItem(npcindex, px, py, select_index)

    local distance = pos_ok(px, py, TaskList[select_index].distance)

    local throwitem = TaskList[select_index].throwitem
    if (HaveIBBuff(TaskList[select_index].flagbuff) and distance ~= -1) then
        local rand = math.random(1, 100)
        local npclevel = TaskList[select_index].id[2]
        local playerlevel = GetLevel()
        if (select_index == 4) then
            playerlevel = GetPlayerExtLevel()
        end

        local randoms = 0
        if (playerlevel < npclevel) then
            randoms = 0.33
        else
            randoms = 10 / (playerlevel - npclevel + 30)
        end

        if (select_index == 4) then
            randoms = 1 / 3
        end

        if (rand <= randoms * 100) then
            local num = GetTaskByte(task_info, 3)
            if (num >= 10) then
                Msg2Player("Äú±¾´Î»ñÈ¡ÍõÄ¸µÄÀñ´üÊıÁ¿ÒÑ´ïÉÏÏŞ 10 c¸i, ´Ëá¦ÆìÊ±¼äÄÚÎŞ·¨ÔÙ»ñµÃ.")
                return
            end

            SetTaskByte(task_info, 3, num + 1)

            AddNormalItemBind(throwitem[1], throwitem[2], throwitem[3], throwitem[4], 0, 0, 1)
            Msg2Player("ÔÚÆì×Ó·¶Î§ÄÚ´ò°ÜÖ¸¶¨Ò°¹Ö, nhËn ®­îc " .. GetNormalItemName(throwitem[1], throwitem[2], throwitem[3], throwitem[4]))
            WriteLog("[Ho¹t ®éng Hung Thó][NhËn ®­îcÀñ´ü]´ò°Ü¹ÖÎï" .. TaskList[select_index].name .. ",»ñµÃÍõÄ¸Àñ´ü" .. select_index .. ",µ±Ç°á¦ÆìÒÑ¾­ nhËn ®­îc " .. GetTaskByte(task_info, 3) .. ".")

        else
            Msg2Player("ÔÚÆì×Ó·¶Î§ÄÚ´ò°ÜÖ¸¶¨Ò°¹Ö,ºÜÒÅº¶Õâ´ÎÃ»ÓĞ nhËn ®­îc " .. GetNormalItemName(throwitem[1], throwitem[2], throwitem[3], throwitem[4]))
        end
    elseif (distance == -1) then
        Msg2Player("´ò°ÜÒ°¹ÖÎ»ÖÃ³¬³öá¦Æì·¶Î§.")
    end
end

function GetRandIndex(info)

    if (info == nil) then
        return -1, -1
    end

    local nRand = math.random(1, 1 * g_Magnitude)
    local nRandSum = 0

    local nlenth = #info

    local start = 1

    for i = start, nlenth do

        if (info[i] == nil or info[i].prob == nil) then
            return -1, -1
        end

        nRandSum = nRandSum + (info[i].prob * g_Magnitude)

        if (nRand <= nRandSum) then
            return i, nRand
        end
    end

    return nlenth, nRand
end

function no()

    CloseDialog()
end

function keys(tables, index)

    local count = 1
    for key, value in ipairs(tables) do
        if (count == index) then
            return key
        end

        count = count + 1
    end

end

function AddAward(award_list)

    if (award_list == nil) then
        return
    end

    local level = GetLevel()
    local str = ""

    if (award_list[1] == 0 and award_list[2] == 0 and award_list[3] == 0) then
        local number = math.pow(level, 3) * award_list[4] / 100
        AddOwnExp(number)
        str = str .. number .. " kinh nghiÖm"
    elseif (award_list[1] == -1 and award_list[2] == -1 and award_list[3] == -1) then
        local number = level * award_list[4]
        EarnBind(number)
        str = str .. number .. "B¹c khãa"
    elseif (award_list[1] == -2 and award_list[2] == -2 and award_list[3] == -2) then
        local number = level * award_list[4]
        Earn(number)
        str = str .. number .. "TiÒn"
    else
        local four = 0
        if (award_list[1] == 6) then
            four = 1
        end

        local count = award_list[4]
        for i = 1, count do
            AddNormalItemBind(award_list[1], award_list[2], award_list[3], four, 0, 0, 1)
        end
        str = str .. count .. "." .. GetNormalItemName(award_list[1], award_list[2], award_list[3], four)
    end

    return str
end

function AddSuperWomanBooks(percent)
    if (IsopenBeast() == 0) then
        return 0
    end

    local random = math.random(1, 100)
    if (random > percent) then
        return 0
    end

    if (IsHaveSpaceForTreasure(2) < 0) then
        local name = GetName()
        SendSysItemMailToTarget("Hép th­", name, "GM", "Ng­êi ch¬i th©n mÕn:ÒòÎªÄúµÄ±³°üÒÑÂú, ´Ë±¦±´ÒÔÓÊ¼şĞÎÊ½·Éµ½ÄúÉí±ß, ÇëÄú²éÊÕ!", book_id[1], book_id[2], book_id[3], book_id[4], 0, 0, 0, 1, 1)
        return 1
    end

    AddNormalItemBind(book_id[1], book_id[2], book_id[3], book_id[4], 0, 0, 1)
    return 1
end

function ResetOracleBeast()
    SetTask(failed_count, 0)
    SetTaskByte(failed_flag, 1, 0)
    SetTaskByte(failed_flag, 2, 0)
    SetTaskByte(failed_flag, 3, 0)
end

function IsopenBeast()
    if (GetGlobalStoreValueByte(92, 4) == 0) then
        return 0
    end

    local lvl = GetGlobalStoreValueByte(92, 3)
    if (GetLevel() < lvl and GetNewBirthTimes() < 1) then
        return 0
    end

    local StartDay = GetGlobalStoreValue(123)
    local EndDay = GetGlobalStoreValue(124)
    local y, m, d = GetYMD()
    local today = y * 10000 + m * 100 + d

    if (today >= StartDay and today <= EndDay) then
        return 1
    end
    return 0
end

